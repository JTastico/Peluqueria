APP_NAME="Peluqueria API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.tudominio.com
APP_TIMEZONE=America/Lima
APP_LOCALE=es

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=peluqueria
DB_USERNAME=
DB_PASSWORD=

# Caché en archivos: funciona en cualquier hosting sin servicios extra
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12

# Secreto para firmar los tokens (mínimo 32 caracteres). Generar con: php -r "echo bin2hex(random_bytes(48));"
JWT_SECRET=
JWT_EXPIRES_MINUTES=720

# Origen exacto del frontend permitido por CORS (varios separados por coma)
FRONTEND_ORIGIN=https://app.tudominio.com
# Detrás de un proxy inverso: IPs de confianza o * (para que el límite de peticiones vea la IP real)
TRUSTED_PROXIES=
RATE_LIMIT_MAX=300

# Administrador inicial: si ADMIN_PASSWORD está vacío se genera una al azar y se imprime una vez
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Datos de ejemplo (solo desarrollo)
SEED_DEMO=false
