DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=peluqueria
PORT=3001
NODE_ENV=development

# Secreto para firmar los tokens (mínimo 32 caracteres). Generar con: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Origen del frontend permitido por CORS (separar con comas si son varios)
FRONTEND_ORIGIN=http://localhost:8080
# Contraseña del admin inicial (opcional; si falta se genera una al azar y se imprime una vez)
ADMIN_PASSWORD=
# Si hay un proxy inverso delante (nginx, etc.): número de proxies
TRUST_PROXY=
# Peticiones por minuto y por IP
RATE_LIMIT_MAX=300
